{
  "name": "dsh-bundle-builder",
  "version": "0.1.0",
  "description": "Convention-first builder for ordinary installable DSH Bundle packages",
  "keywords": [
    "deepseek",
    "dsh",
    "bundle",
    "plugin",
    "builder"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-bundle": "./bin.js"
  },
  "files": [
    "lib",
    "bin.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint src tests *.ts",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "test:coverage": "rstest run --coverage",
    "test:built": "rstest run --config rstest.built.config.ts",
    "publint": "publint",
    "pack:check": "npm pack --dry-run --json",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:built && pnpm publint"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/dsh-bundle-builder.git"
  },
  "bugs": {
    "url": "https://github.com/2heal1/dsh-bundle-builder/issues"
  },
  "homepage": "https://github.com/2heal1/dsh-bundle-builder#readme",
  "license": "MIT",
  "dependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^0.23.2",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "devDependencies": {
    "@rstest/adapter-rslib": "^0.11.10",
    "@rstest/core": "^0.11.10",
    "@rstest/coverage-v8": "^0.11.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "typescript": "^6.0.3"
  }
}
